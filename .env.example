# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and auto-loaded by `app/cli.py` at startup.

# ElevenLabs TTS (default provider). Required unless you swap to a different
# provider in config.yaml.
ELEVENLABS_API_KEY=sk_replace_me

# DO NOT set ANTHROPIC_API_KEY here. The pipeline uses claude-agent-sdk which
# auto-detects your Claude Code session (Max subscription). Setting an API key
# would cause the SDK to bill the API account instead.

# Optional: override default Claude model identifiers used per phase.
# PODCAST_SCRIPT_MODEL=claude-opus-4-7
# PODCAST_SUMMARY_MODEL=claude-haiku-4-5-20251001
# PODCAST_COMPRESS_MODEL=claude-haiku-4-5-20251001
